{
  "name": "spec-to-order-sheet",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "packageManager": "pnpm@11.25.0",
  "engines": {
    "node": ">=22.13"
  },
  "scripts": {
    "gen": "tsx tools/gen/gen.ts",
    "gen:check": "tsx tools/gen/gen.ts --check",
    "lint": "eslint .",
    "format": "prettier --write .",
    "typecheck": "tsc --noEmit && pnpm -r --if-present typecheck",
    "test": "vitest run && pnpm -r --filter \"./apps/*\" --if-present test"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@repo/shared": "workspace:*",
    "@types/node": "^22.20.3",
    "eslint": "^10.10.0",
    "eslint-import-resolver-typescript": "^4.4.5",
    "eslint-plugin-boundaries": "^7.2.0",
    "globals": "^17.12.0",
    "prettier": "^3.9.7",
    "tsx": "^4.23.13",
    "typescript": "^6.0.3",
    "typescript-eslint": "^8.70.0",
    "vitest": "^5.0.1"
  }
}
