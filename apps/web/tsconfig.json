{
  "extends": "../../packages/shared/src/config/tsconfig.base.json",
  "compilerOptions": {
    // ⚠ ブラウザ (React) と Worker のコードが同じ src/ に混ざるので、lib は DOM に揃え、
    //   Workers の型は **global に入れず** `@cloudflare/workers-types` から名前で import する
    //   (`types: ["@cloudflare/workers-types"]` にすると DOM と Request / Response が衝突する)。
    //   入口は shared/hono.ts の Bindings。
    "lib": ["ES2023", "DOM", "DOM.Iterable"],
    "jsx": "react-jsx",
    "types": ["node", "vite/client"]
  },
  "include": [
    "src/**/*.ts",
    "src/**/*.tsx",
    "vite.config.ts",
    "vitest.config.ts",
    "drizzle.config.ts"
  ]
}
