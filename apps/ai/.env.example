# apps/ai (Mastra) のローカル用の環境変数。
#   cp apps/ai/.env.example apps/ai/.env
# ⚠ 値は単一引用符で囲む (mastra dev の dotenv は二重引用符の中の \" を戻さない)。
# 検査の正は packages/shared/src/env/ai.ts (zod)。

AI_DEFAULT_MODEL='openai/gpt-5-mini'
# ★ 読み取り 1 通ぶんの上限 (ミリ秒)。Mastra の既定 (180 秒) では足りない。
AI_REQUEST_TIMEOUT_MS='900000'

# ★ 読み取りに使う OpenAI の API キー。各自のものを入れる。
OPENAI_API_KEY=''

# workflow の snapshot と trace の保存先 (LIBSQL_URL)。
# ⚠ **絶対パスで書く。** mastra dev はビルドした apps/ai/.mastra/output で動くので、相対パスは
#   そこから解かれて開けない。リポジトリのルートで次を打つと末尾に足される:
#     echo "LIBSQL_URL='file:$PWD/.local/data/mastra.db'" >> apps/ai/.env
LIBSQL_AUTH_TOKEN=''

# mastra dev が待つ port (gcp-emulator がここへ転送する)。
PORT='4011'

# --- 任意: Langfuse (自前の Langfuse v4 があるときだけ) ------------------------
# 無くても動く。実行中のトレースは Mastra Studio (http://127.0.0.1:4011) で見られる。
# LANGFUSE_BASE_URL='http://127.0.0.1:3150'
# LANGFUSE_ENVIRONMENT='local'
# LANGFUSE_PUBLIC_KEY='pk-lf-...'
# LANGFUSE_SECRET_KEY='sk-lf-...'
