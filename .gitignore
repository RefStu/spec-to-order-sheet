# ============================================================================
# spec-to-order-sheet / .gitignore
# ============================================================================

# --- 依存 / ビルド -----------------------------------------------------------
node_modules/
dist/
.mastra/
.turbo/
*.tsbuildinfo

# --- 自動生成 (tools/gen/gen.ts) ---------------------------------------------
# ⚠ 登録ファイルはコミットしない。feature を足すたびに共通ファイルを書き換えると
#   ブランチ同士で衝突するための自動生成。dev / build / CI の前に必ず生成される。
*.gen.ts
*.gen.tsx

# --- 環境変数 (値を含む) -------------------------------------------------------
# ⚠ 例のファイル (*.example) だけを追跡する。値は各自がコピーして書く。
.env
.env.*
!.env.example
.dev.vars
.dev.vars.*
!.dev.vars.example
*.auto.tfvars.json
terraform.tfvars

# --- ローカル状態 -------------------------------------------------------------
# file: DB / ダミー SA 鍵 / ログ など
.local/
.wrangler/
.direnv/
*.pem
# ⚠ 実物の帳票。**追跡下に置かない。**
#   テストの fixture には使わず、固有名詞を伏せた架空のものを別に作ること。
assets/

# --- Terraform ---------------------------------------------------------------
.terraform/
*.tfstate
*.tfstate.*
crash.log

# --- OS / エディタ ------------------------------------------------------------
.DS_Store
*.log

# 鍵ファイルの保険 (SA 鍵などを誤ってコミットしない)
*-key.json
*sa-key*.json
