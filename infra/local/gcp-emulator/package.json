{
  "name": "@repo/gcp-emulator",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "description": "ローカルで Cloud Run IAM と Google の token endpoint を再現する小さな Hono サーバー。apps/web を本番と同じコードのまま動かすためにある。",
  "scripts": {
    "start": "tsx src/index.ts",
    "dev": "tsx watch src/index.ts",
    "keys": "tsx src/generate-keys.ts",
    "typecheck": "tsc --noEmit"
  },
  "dependencies": {
    "@hono/node-server": "^1.19.17",
    "hono": "^4.13.8",
    "undici": "^6.21.0"
  },
  "devDependencies": {
    "@types/node": "^22.20.3",
    "tsx": "^4.23.13",
    "typescript": "~6.0.3",
    "vitest": "^5.0.1"
  }
}
